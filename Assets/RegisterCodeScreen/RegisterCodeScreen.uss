/* RegisterCodeScreen.uss — "Create an Account" code entry card (mockup slide 2). */

.code-card {
    margin-top: 72px;
    height: 287px;
    padding: 12px 45px 24px 45px;
    align-items: center;
}

.code-card__text {
    width: 435px;
    margin-top: 46px;
}

.code-card__input {
    width: 331px;
    margin-top: 18px;
}

.code-card__submit {
    margin-top: 28px;
}

.code-card__error {
    top: 40px;
    height: 44px;
}
