/* ForgotPasswordScreen.uss — "Forgot Your Password?" card (mockup slide 22). */

.forgot-card {
    height: 449px;
    padding: 20px 45px 14px 45px;
    align-items: center;
}

.forgot-card__column {
    width: 360px;
}

.forgot-card__text {
    margin-top: 18px;
}

.forgot-card__label {
    margin-top: 45px;
    margin-bottom: 6px;
}

.forgot-card__submit {
    margin-top: 36px;
}
