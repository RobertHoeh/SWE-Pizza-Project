<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="/Assets/NavBar.uss"/>
    <ui:VisualElement name="NavBarRoot" class="navbar">
        <ui:VisualElement class="navbar__pill">
            <ui:Button text="LOGO&#10;HERE" parse-escape-sequences="false" name="LogoButton" class="navbar__btn navbar__logo"/>
            <ui:Button text="Dashboard" parse-escape-sequences="false" name="DashboardButton" class="navbar__btn navbar__dashboard"/>
        </ui:VisualElement>
        <ui:VisualElement class="navbar__spacer"/>
        <ui:VisualElement class="navbar__pill">
            <!-- Shows "Log in" when signed out, the username when signed in. -->
            <ui:Button text="Log in" parse-escape-sequences="false" name="LoginButton" class="navbar__btn navbar__user"/>
            <ui:Button parse-escape-sequences="false" name="DropdownButton" class="navbar__btn">
                <ui:Image source="project://database/Assets/avatar-default-svgrepo-com%201.png?fileID=2800000&amp;guid=19a20739214f0074fbbc4d952fc8809f&amp;type=3#avatar-default-svgrepo-com 1" scale-mode="ScaleToFit" class="navbar__avatar"/>
            </ui:Button>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
