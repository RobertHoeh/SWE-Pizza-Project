/* MenuItemModal.uss — "ADD NEW ITEM" / "EDIT ITEM" popup (mockup slides 97, 102, 106). */

.item-modal__content {
    flex-direction: row;
    margin: 30px 0 0 56px;
}

/* ---- left key/value table ---- */
.item-table {
    align-self: flex-start;
    width: 476px;
    border-top-width: 1px;
    border-left-width: 1px;
    border-color: #404040;
}

.item-table__row {
    flex-direction: row;
    height: 80px;
    border-bottom-width: 1px;
    border-color: #404040;
}

.item-table__row--short {
    height: 59px;
}

.item-table__key {
    width: 154px;
    padding: 14px 12px;
    border-right-width: 1px;
    border-color: #404040;
    font-size: 23px;
    color: var(--c-black);
}

.item-table__value {
    flex-grow: 1;
    padding: 14px 10px;
    border-right-width: 1px;
    border-color: #404040;
}

.item-table__input > .unity-base-text-field__input,
.item-table__input:hover > .unity-base-text-field__input,
.item-table__input:focus > .unity-base-text-field__input {
    font-size: 23px;
}

/* ---- right image drop zone ---- */
.item-modal__image-column {
    margin-left: 16px;
    width: 493px;
    align-items: center;
}

.item-modal__image-box {
    width: 493px;
    height: 274px;
    border-width: 2px;
    border-color: var(--c-black);
    align-items: center;
    justify-content: center;
}

.item-modal__image {
    position: absolute;
    left: 78px;
    right: 78px;
    top: 22px;
    bottom: 22px;
    -unity-background-scale-mode: scale-to-fit;
}

.item-modal__drop-hint {
    font-size: 22px;
    color: #595959;
}

.item-modal__remove {
    margin-top: 15px;
    width: 181px;
    height: 40px;
    font-size: 15px;
}

/* ---- submit button (centred on the modal) ---- */
.item-modal__submit-row {
    position: absolute;
    top: 405px;
    left: 0;
    right: 0;
    align-items: center;
}

.item-modal__submit {
    width: 205px;
    height: 46px;
    font-size: 23px;
}
