/* PlaceOrderModal.uss — "Place Order" popup (mockup slides 40-76).
   All positions are relative to the 1078 x 583 modal. */

.po-fill {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
}

/* ------------------------------------------------------------------ */
/* Stepper: Record Order -> Customer Information -> Receipt           */
/* ------------------------------------------------------------------ */
.po-stepper {
    position: absolute;
    top: 19px;
    left: 227px;
    flex-direction: row;
    align-items: center;
}

.po-step {
    font-size: 20px;
    -unity-font-definition: url("/Assets/arial-cufonfonts/ARIALBD.TTF");
    color: var(--c-black);
    padding-bottom: 1px;
}

.po-step--active {
    border-bottom-width: 2px;
    border-color: var(--c-black);
}

.po-step-arrow {
    flex-direction: row;
    align-items: center;
    margin: 0 2px 0 8px;
}

.po-step-arrow__line {
    width: 50px;
    height: 1px;
    background-color: #404040;
}

.po-step-arrow__head {
    font-size: 9px;
    color: #404040;
    margin-left: -3px;
}

/* ------------------------------------------------------------------ */
/* Left content area                                                  */
/* ------------------------------------------------------------------ */
.po-left {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 810px;
}

/* ---- tabs ---- */
.po-tabs {
    position: absolute;
    left: 25px;
    top: 51px;
    flex-direction: row;
}

.po-tab,
.po-tab:hover,
.po-tab:focus {
    width: 152px;
    height: 25px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    background-color: var(--c-lavender);
    justify-content: center;
    align-items: center;
}

.po-tab--wide,
.po-tab--wide:hover {
    width: 176px;
}

.po-tab--active,
.po-tab--active:hover,
.po-tab--active:focus {
    background-color: var(--c-purple);
}

.po-tab__label {
    font-size: 17px;
    -unity-font-definition: url("/Assets/arial-cufonfonts/ARIALBD.TTF");
    color: var(--c-white);
}

.po-tab--active .po-tab__label {
    border-bottom-width: 1px;
    border-color: var(--c-white);
}

.po-tab-panel {
    position: absolute;
    left: 25px;
    top: 76px;
    width: 775px;
    bottom: 24px;
    border-width: 1px;
    border-color: var(--c-black);
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
    overflow: hidden;
}

/* ---- shared option rows (radio / checkbox + price) ---- */
.opt {
    flex-direction: row;
    align-items: center;
    height: 21px;
}

.opt__choice {
    flex-grow: 1;
}

.opt__price {
    font-size: 17px;
    color: var(--c-black);
    -unity-text-align: middle-right;
    min-width: 30px;
}

.toppings-col {
    width: 181px;
}

.po-heading {
    font-size: 21px;
    -unity-font-definition: url("/Assets/arial-cufonfonts/ARIALBD.TTF");
    color: var(--c-black);
}

.po-add-to-cart {
    border-radius: 12px;
    width: 100px;
    height: 24px;
    padding: 0;
    font-size: 13px;
}

.po-add-to-cart--corner {
    position: absolute;
    right: 15px;
    bottom: 12px;
}

/* ---- Premade Pizzas ---- */
.premade {
    flex-direction: row;
    height: 154px;
    padding: 8px 0 0 22px;
}

.premade__info {
    width: 182px;
}

.premade__image {
    width: 181px;
    height: 121px;
    margin-top: 2px;
    border-radius: 15px;
    background-image: url("/Assets/Common/Images/PizzaPlaceholder.png");
    -unity-background-scale-mode: scale-and-crop;
}

.premade__sizes {
    width: 180px;
    padding-left: 10px;
}

.premade__toppings {
    margin-left: 9px;
}

.toppings-col--second {
    margin-left: 9px;
}

.premade .choice .unity-label,
.premade .opt__price {
    font-size: 18px;
}

.premade__add {
    align-self: flex-end;
    margin-top: 4px;
    width: 84px;
    height: 18px;
    border-radius: 9px;
    font-size: 12px;
}

/* ---- Custom Pizzas ---- */
.custom {
    padding: 10px 0 0 14px;
}

.custom__section {
    margin-bottom: 8px;
}

.custom__heading {
    font-size: 20px;
    -unity-font-definition: url("/Assets/arial-cufonfonts/ARIALBD.TTF");
    color: var(--c-black);
}

.custom__opt {
    width: 190px;
    margin-left: 8px;
}

.custom__toppings-col {
    margin-left: 6px;
}

/* ---- Beverages & Sides ---- */
.sides {
    padding: 12px 0 0 22px;
}

.sides__heading {
    font-size: 25px;
    -unity-font-definition: url("/Assets/arial-cufonfonts/ARIALBD.TTF");
    color: var(--c-black);
}

.sides__group {
    margin-top: 14px;
}

.sides__opt {
    width: 300px;
    height: 26px;
    margin-left: 8px;
}

.sides .choice .unity-label,
.sides .opt__price {
    font-size: 20px;
}

/* ------------------------------------------------------------------ */
/* Steps 2 & 3: centred panels                                        */
/* ------------------------------------------------------------------ */
.po-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
}

.po-title {
    font-size: 20px;
    -unity-font-definition: url("/Assets/arial-cufonfonts/ARIALBD.TTF");
    color: var(--c-black);
    -unity-text-align: middle-center;
}

.po-text {
    font-size: 20px;
    color: var(--c-black);
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.po-table {
    width: 569px;
}

.po-table__row {
    min-height: 48px;
}

.po-table__row--tall {
    min-height: 72px;
}

.po-table .info-table__key,
.po-table .info-table__value {
    padding: 11px 10px;
}

.po-small-btn {
    border-radius: 17px;
    height: 34px;
    width: 161px;
    padding: 0;
    font-size: 17px;
}

.po-small-btn--wide {
    width: 235px;
}

/* lookup */
.po-lookup__title { margin-top: 130px; }
.po-lookup__table { margin-top: 30px; }
.po-lookup__find { margin-top: 66px; width: 235px; }

/* finding */
.po-finding__title { margin-top: 200px; }
.po-spinner {
    margin-top: 20px;
    width: 30px;
    height: 30px;
    border-radius: 15px;
    border-width: 4px;
    border-color: var(--c-black);
    border-top-color: rgba(0, 0, 0, 0);
}

/* found / not found */
.po-record__title { margin-top: 90px; }
.po-record__table { margin-top: 18px; }
.po-record__buttons {
    flex-direction: row;
    margin-top: 12px;
}
.po-record__use { margin-left: 85px; }
.po-record__create { margin-top: 12px; }

/* delivery method */
.po-delivery__title { margin-top: 128px; }

.po-delivery__options {
    align-self: flex-start;
    margin: 14px 0 0 220px;
}

.po-delivery__opt {
    height: 27px;
}

.po-delivery__opt--delivery {
    margin-top: 8px;
}

.po-delivery__choice {
    width: 156px;
    flex-grow: 0;
}

.po-delivery__opt--delivery .po-delivery__choice {
    width: auto;
}

.po-delivery__choice .unity-label {
    font-size: 22px;
}

.po-delivery__fee {
    font-size: 22px;
    margin-left: 30px;
}

.po-delivery__review { margin-top: 75px; }

/* review */
.po-review__title { margin-top: 70px; }
.po-review__table { margin-top: 20px; }
.po-review__wait-label { margin-top: 16px; }
.po-review__place { margin-top: 10px; width: 164px; height: 38px; border-radius: 19px; }

/* placed */
.po-placed__title { margin-top: 105px; }
.po-placed__wait-label { margin-top: 98px; }
.po-placed__buttons {
    flex-direction: row;
    margin-top: 112px;
}
.po-placed__btn { width: 163px; height: 37px; border-radius: 19px; }
.po-placed__ok { margin-left: 49px; }

/* ------------------------------------------------------------------ */
/* Right: order details                                               */
/* ------------------------------------------------------------------ */
.po-divider {
    position: absolute;
    left: 810px;
    top: 41px;
    width: 2px;
    height: 446px;
    background-color: #404040;
}

.po-details {
    position: absolute;
    left: 821px;
    top: 41px;
    width: 225px;
    height: 450px;
}

.po-details__title {
    font-size: 20px;
    -unity-font-definition: url("/Assets/arial-cufonfonts/ARIALBD.TTF");
    color: var(--c-black);
}

.po-details__items {
    flex-grow: 1;
    margin-top: 16px;
}

.po-item__head {
    flex-direction: row;
    align-items: center;
}

.po-item__name {
    font-size: 17px;
    -unity-font-definition: url("/Assets/arial-cufonfonts/ARIALBD.TTF");
    color: var(--c-black);
}

.po-item__price {
    font-size: 17px;
    color: var(--c-black);
    margin-left: 6px;
}

.po-item__detail {
    font-size: 17px;
    color: var(--c-black);
    padding-left: 22px;
}

.po-qty {
    flex-direction: row;
    align-items: center;
    height: 18px;
    margin-left: 8px;
    padding: 0 4px;
    border-radius: 9px;
    background-color: var(--c-purple);
}

.po-qty__btn,
.po-qty__btn:hover,
.po-qty__btn:focus {
    margin: 0;
    padding: 0 3px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--c-white);
    font-size: 13px;
    -unity-font-definition: url("/Assets/arial-cufonfonts/ARIALBD.TTF");
}

.po-qty__count {
    font-size: 13px;
    color: var(--c-white);
    margin: 0 4px;
}

.po-details__total {
    flex-direction: row;
    height: 30px;
    align-items: center;
}

.po-details__total-label {
    width: 137px;
    font-size: 17px;
    -unity-font-definition: url("/Assets/arial-cufonfonts/ARIALBD.TTF");
    color: var(--c-black);
}

.po-details__total-value {
    font-size: 17px;
    color: var(--c-black);
}

/* ------------------------------------------------------------------ */
/* Round next / back buttons                                          */
/* ------------------------------------------------------------------ */
.po-next {
    position: absolute;
    right: 11px;
    bottom: 12px;
    font-size: 44px;
}

.po-back {
    position: absolute;
    left: 16px;
    bottom: 14px;
    font-size: 44px;
}
