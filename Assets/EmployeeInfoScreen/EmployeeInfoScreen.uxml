<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <!--
        "EMPLOYEE INFORMATION" page reached from the account dropdown (slides 32-38).
        Value cells are read-only TextFields; clear "readonly" when "Edit Information" is pressed.
    -->
    <ui:Template name="NavBar" src="/Assets/NavBar.uxml"/>
    <Style src="/Assets/Common/Common.uss"/>
    <Style src="/Assets/EmployeeInfoScreen/EmployeeInfoScreen.uss"/>
    <ui:VisualElement name="EmployeeInfoScreen" class="page">
        <ui:Instance template="NavBar" name="NavBar" class="navbar-instance"/>
        <ui:VisualElement class="page__body employee-info">
            <ui:Label text="EMPLOYEE INFORMATION" class="page-title"/>

            <ui:VisualElement class="info-table employee-info__table">
                <ui:VisualElement class="info-table__row">
                    <ui:VisualElement class="info-table__key"><ui:Label text="Name:" class="info-table__key-text"/></ui:VisualElement>
                    <ui:VisualElement class="info-table__value"><ui:TextField name="NameField" value="Jack Smith" readonly="true" placeholder-text="Name" class="cell-input"/></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="info-table__row">
                    <ui:VisualElement class="info-table__key"><ui:Label text="Department:" class="info-table__key-text"/></ui:VisualElement>
                    <ui:VisualElement class="info-table__value"><ui:TextField name="DepartmentField" value="Employee" readonly="true" placeholder-text="Department" class="cell-input"/></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="info-table__row">
                    <ui:VisualElement class="info-table__key"><ui:Label text="Contacts:" class="info-table__key-text"/></ui:VisualElement>
                    <ui:VisualElement class="info-table__value">
                        <ui:TextField name="PhoneField" value="+1 404-846-1236" readonly="true" placeholder-text="Phone" class="cell-input"/>
                        <ui:TextField name="EmailField" value="employee2@gmail.com" readonly="true" placeholder-text="Email" class="cell-input"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="info-table__row">
                    <ui:VisualElement class="info-table__key"><ui:Label text="Username:" class="info-table__key-text"/></ui:VisualElement>
                    <ui:VisualElement class="info-table__value"><ui:TextField name="UsernameField" value="Employee2" readonly="true" placeholder-text="Username" class="cell-input"/></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="employee-info__buttons">
                <ui:Button name="EditInfoButton" text="Edit Information" class="btn btn--green btn--md"/>
                <ui:Button name="ResetPasswordButton" text="Reset Password" class="btn btn--purple btn--md employee-info__reset"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
