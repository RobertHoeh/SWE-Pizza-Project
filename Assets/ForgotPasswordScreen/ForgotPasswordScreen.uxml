<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="NavBar" src="/Assets/NavBar.uxml"/>
    <Style src="/Assets/Common/Common.uss"/>
    <Style src="/Assets/ForgotPasswordScreen/ForgotPasswordScreen.uss"/>
    <ui:VisualElement name="ForgotPasswordScreen" class="page">
        <ui:Instance template="NavBar" name="NavBar" class="navbar-instance"/>
        <ui:VisualElement class="auth-body">
            <ui:VisualElement class="card forgot-card">
                <ui:Label text="Forgot Your Password?" class="card__title"/>
                <ui:VisualElement class="forgot-card__column">
                    <ui:Label text="Enter your email and we’ll send you a link to reset your password" class="card__text forgot-card__text"/>
                    <ui:Label text="Email address" class="card__label forgot-card__label"/>
                    <ui:TextField name="EmailField" placeholder-text="Email Address" hide-placeholder-on-focus="true" class="input"/>
                </ui:VisualElement>
                <ui:Button name="SendLinkButton" text="Send link to email" class="btn btn--green btn--outlined btn--lg forgot-card__submit"/>

                <ui:VisualElement name="ErrorBanner" class="card-error hidden">
                    <ui:Label name="ErrorText" text="&lt;b&gt;Error&lt;/b&gt;: Please enter a valid email address" class="card-error__text"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
