<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="NavBar" src="/Assets/NavBar.uxml"/>
    <Style src="/Assets/Common/Common.uss"/>
    <Style src="/Assets/ResetPasswordScreen/ResetPasswordScreen.uss"/>
    <ui:VisualElement name="ResetPasswordScreen" class="page">
        <ui:Instance template="NavBar" name="NavBar" class="navbar-instance"/>
        <ui:VisualElement class="auth-body">
            <ui:VisualElement class="card reset-card">
                <ui:Label text="Reset Password" class="card__title"/>

                <ui:Label text="Enter new password" class="card__label reset-card__first-label"/>
                <ui:TextField name="NewPasswordField" password="true" placeholder-text="Password" hide-placeholder-on-focus="true" class="input"/>

                <ui:Label text="Confirm password" class="card__label reset-card__label"/>
                <ui:TextField name="ConfirmPasswordField" password="true" placeholder-text="Password" hide-placeholder-on-focus="true" class="input"/>

                <ui:Button name="ChangePasswordButton" text="Change Password" class="btn btn--green btn--outlined btn--lg reset-card__submit"/>

                <ui:VisualElement name="ErrorBanner" class="card-error hidden">
                    <ui:Label name="ErrorText" text="&lt;b&gt;Error&lt;/b&gt;: Passwords do not match" class="card-error__text"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
